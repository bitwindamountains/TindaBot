APP_ENV=development
DATABASE_URL=sqlite:///data/tindabot.db
# For hosted PostgreSQL use postgresql+psycopg://... with sslmode=require.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_APP_ID=
META_GRAPH_VERSION=
ADMIN_TOKEN=
STATUS_TOKEN=
# External sends are disabled until explicitly enabled.
DELIVERY_MODE=dry_run
AUTOMATION_ENABLED=true
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SELLER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SHOP_NAME=TindaBot Demo
PRIVACY_URL=
SHIPPING_MINOR=8000
PICKUP_ADDRESS=Contact the seller for pickup details
PAYMENT_METHODS=cod
GCASH_INSTRUCTIONS=
BANK_INSTRUCTIONS=
MAX_MESSAGES_PER_MINUTE=20
CATALOG_MAX_AGE_SECONDS=3600
ORDER_PII_RETENTION_DAYS=365
EVENT_RETENTION_DAYS=7
UNPAID_EXPIRY_HOURS=24
WORKER_POLL_SECONDS=1
# Set only after seller accepts privacy, stock allocation and recovery policies.
PRODUCTION_ACKNOWLEDGED=false
